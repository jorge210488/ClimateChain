{
  "name": "backend",
  "version": "1.0.0",
  "description": "ClimateChain NestJS API foundation coordinating policy, pricing, and blockchain integration flows.",
  "author": "",
  "private": true,
  "license": "ISC",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20.10.0 <21 || >=22",
    "npm": ">=10"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "start:check": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register scripts/startup-check.ts",
    "api:export": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register scripts/export-openapi.ts",
    "api:check": "cross-env NODE_ENV=test ts-node -r tsconfig-paths/register scripts/check-openapi.ts",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"{src,test,scripts}/**/*.ts\" --fix",
    "format:check": "prettier --check \"{src,test,scripts}/**/*.ts\"",
    "format:write": "prettier --write \"{src,test,scripts}/**/*.ts\"",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:cov": "cross-env NODE_ENV=test CHAIN_E2E_RPC_URL=http://127.0.0.1:8545 jest --config jest.coverage.js --coverage --runInBand",
    "test:e2e": "cross-env NODE_ENV=test jest --config test/jest-e2e.json --runInBand --testPathIgnorePatterns chain.e2e-spec.ts",
    "test:e2e:chain": "cross-env NODE_ENV=test CHAIN_E2E_RPC_URL=http://127.0.0.1:8545 jest --config test/jest-e2e.json --runInBand --testPathPattern chain.e2e-spec.ts",
    "audit:check": "npm audit --audit-level=critical",
    "quality:check": "npm run lint && npm run format:check",
    "stage5:check": "npm run build && npm run quality:check && npm run audit:check && npm run test && npm run test:e2e && npm run start:check && npm run api:check",
    "stage6:check": "npm run stage5:check && npm run test:e2e:chain && npm run test:cov"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ethers": "^6.13.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "nestjs-pino": "^4.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@swc/core": "^1.10.0",
    "@swc/jest": "^0.2.37",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "@swc/jest"
      ]
    },
    "testEnvironment": "node"
  }
}
