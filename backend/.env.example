# Backend module environment
#
# Copy to `.env` and adjust. Values left empty fall back to safe defaults for
# local/dev/test profiles. Deployed profiles (staging/testnet/production) must
# provide real secrets; the config schema fails fast when they are missing.

# Runtime profile: development | test | staging | testnet | production
NODE_ENV=development
PORT=3000

# Observability: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- HTTP surface ---
# Comma-separated CORS origin allowlist, e.g. https://app.example.com,https://admin.example.com
# Empty reflects any origin (local/dev/test only); required for deployed profiles.
CORS_ORIGINS=
# Interactive API docs at /docs. Defaults to enabled locally, disabled for
# staging/testnet/production. Set to true to expose them on a deployed profile.
SWAGGER_ENABLED=
# Maximum request body size (Express syntax, e.g. 64kb).
MAX_REQUEST_BODY_SIZE=64kb

# --- Blockchain integration (Stage 05 loads ABI/manifest; Stage 06 uses RPC) ---
# Network key resolving contracts/deployments/<network>.json.
# Use `localhost` (standalone node, reachable over RPC) rather than `hardhat`
# (in-process, addresses unreachable) for anything that runs this service.
# See docs/runbooks/local-stack.md.
BLOCKCHAIN_NETWORK=localhost
# Optional but recommended: boot fails when it disagrees with the manifest,
# which catches "pointing at the wrong chain" immediately.
CHAIN_ID=31337
# Mandatory for staging/testnet/production (boot fails without it); optional for
# local/dev/test until Stage 06 wires live integration.
RPC_URL=
# Signer key, 0x-prefixed 32-byte hex. Format is validated at boot when set.
# Required for policy creation; reads work without it. Each running instance
# needs its own account: two instances sharing one signer collide on nonces.
PRIVATE_KEY=

# --- Chain client tuning ---
# Confirmations awaited before a write is reported as mined. 1 is right for a
# local node; raise it on public networks, where one block can be reorganized.
CHAIN_CONFIRMATIONS=1
# Per-RPC-call timeout; beyond this the call is treated as transient.
CHAIN_RPC_TIMEOUT_MS=10000
# How long to wait for a submitted transaction to be mined.
CHAIN_TX_TIMEOUT_MS=120000
# Attempts for a transient RPC failure, including the first. Reads only:
# writes are never retried, because a retry can submit a duplicate policy.
CHAIN_RETRY_ATTEMPTS=3
CHAIN_RETRY_BASE_DELAY_MS=250
# Cap on policies per paginated read; each item costs several RPC calls.
# Responses report the applied limit, which may be lower than the one requested.
CHAIN_MAX_PAGE_SIZE=50
# Rate limit for the public policy read endpoints, per client address. These are
# anonymous and each fans out into many RPC calls, so the limit protects the
# node and the RPC bill rather than the API process.
CHAIN_READ_RATE_LIMIT_TTL_SECONDS=60
CHAIN_READ_RATE_LIMIT_MAX=60
# Optional: overrides the provider address from the deployment manifest
FACTORY_ADDRESS=
# Optional overrides (default to ../shared/abi and ../contracts/deployments)
SHARED_ABI_DIR=
CONTRACTS_DEPLOYMENTS_DIR=

# --- ML pricing service integration (live calls wired in Stage 09) ---
ML_SERVICE_BASE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=5000

# --- Auth ---
# Min length 16. Empty uses an insecure local-dev placeholder; required for
# staging/testnet/production.
JWT_SECRET=
JWT_EXPIRES_IN=1d
# When set, enables POST /auth/token to exchange this key for an admin JWT.
# Minimum 32 characters: it is the only credential guarding token issuance.
ADMIN_API_KEY=
# Abuse controls for POST /auth/token (per client address).
AUTH_RATE_LIMIT_TTL_SECONDS=60
AUTH_RATE_LIMIT_MAX=10

# --- Optional Stage 11 off-chain persistence ---
DATABASE_URL=
