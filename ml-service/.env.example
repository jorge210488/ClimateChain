# ML service environment
#
# Copy to `.env`. No secrets are required: the service prices from a local
# artifact and calls nothing external, and the training data comes from an open
# endpoint that needs no key.

# One of: development, test, staging, testnet, production.
APP_ENV=development
APP_PORT=8000
# One of: debug, info, warning, error, critical.
LOG_LEVEL=info

# --- Model ---
# Only `baseline` exists so far. A mismatch
# between this and the artifact's own provider aborts startup, so an operator
# cannot silently run a model the deployment was not configured for.
MODEL_PROVIDER=baseline

# Path to the model artifact, absolute or relative to `ml-service/`. Build it
# with `python scripts/train_rainfall_model.py` from the committed rainfall
# history in `data/`. The artifact is JSON holding
# fitted coefficients, not a pickle: loading a pickle executes whatever it
# contains, which is not an acceptable property for a file read at every boot.
MODEL_PATH=app/models/artifacts/baseline-premium-v3.json

# Deployed profiles (staging, testnet, production) refuse to start on a model
# that is not observed and non-transitional — the archived synthetic fit, or
# an artifact that cannot say what it was trained on. This is the only
# override. It is logged at startup, and readiness keeps reporting the
# model's real provenance. Leave it unset unless you are in an incident and
# know why you are pricing from a placeholder.
MODEL_ALLOW_TRANSITIONAL=false

# --- Data provider ---
# Reserved and unused. `scripts/fetch_rainfall_history.py` reads the Open-Meteo
# archive, which is open and keyless; these stay for a provider that is not.
WEATHER_API_BASE_URL=
WEATHER_API_KEY=
