# ML service environment
#
# Copy to `.env`. No secrets are required for Stage 07: the service prices from
# a local artifact and calls nothing external.

# One of: development, test, staging, testnet, production.
APP_ENV=development
APP_PORT=8000
# One of: debug, info, warning, error, critical.
LOG_LEVEL=info

# --- Model ---
# Only `baseline` exists until Stage 08 adds another provider. A mismatch
# between this and the artifact's own provider aborts startup, so an operator
# cannot silently run a model the deployment was not configured for.
MODEL_PROVIDER=baseline

# Path to the model artifact, absolute or relative to `ml-service/`. Build it
# with `python scripts/build_baseline_model.py`. The artifact is JSON holding
# fitted coefficients, not a pickle: loading a pickle executes whatever it
# contains, which is not an acceptable property for a file read at every boot.
MODEL_PATH=app/models/artifacts/baseline-premium-v1.json

# --- Data provider (Stage 08) ---
# Unused in Stage 07. The service reads no external weather API yet; the
# training pipeline that needs these arrives with Stage 08.
WEATHER_API_BASE_URL=
WEATHER_API_KEY=
